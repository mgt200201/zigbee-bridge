CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=5120

# Increase main task stack for Matter commissioning (PBKDF2 verifier)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Reduce WiFi buffers to free DRAM for Zigbee RCP UART driver
# Default: DYNAMIC_RX=32, DYNAMIC_TX=32, STATIC_RX=10
# Each buffer = ~1.6KB, saving ~86KB total
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4

# Reduce NimBLE ACL buffer to save DRAM
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=128

# Limit BLE connections to 1 (only need one commissioner)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Enable FreeRTOS legacy API
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# Enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y

# Enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Watchdog
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Zboss
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_MACSPLIT_UART=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Increase matter console stack size
CONFIG_ESP_MATTER_CONSOLE_TASK_STACK=3072

# disable groupcast cluster until verified
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# Increase max dynamic endpoints for bridged Zigbee devices
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=32

# Use IDF mDNS instead of CHIP's minimal mDNS
# Minimal mDNS cannot fragment UDP broadcast packets,
# causing "mDNS broadcast full failed" when multiple
# IPv6 addresses are present, preventing HA discovery
CONFIG_USE_MINIMAL_MDNS=n

# Optimize IDF mDNS for Matter
# Disable mDNS on unused ETH interface (only STA is needed)
CONFIG_MDNS_PREDEF_NETIF_ETH=n
# Disable mDNS on AP interface (unless you use SoftAP for commissioning)
CONFIG_MDNS_PREDEF_NETIF_AP=n

# Default WiFi credentials for Home Assistant network
CONFIG_DEFAULT_WIFI_SSID="Flymodem2855"
CONFIG_DEFAULT_WIFI_PASSWORD="m19327743237"

# Disable OpenThread - we use WiFi+Zigbee, not Thread
# OpenThread Spinel driver conflicts with Zigbee RCP UART and causes
# "Failed to reset co-processor!" abort on WiFi connection
CONFIG_ESP_MATTER_ENABLE_OPENTHREAD=n
CONFIG_OPENTHREAD_SPINEL_ONLY=n