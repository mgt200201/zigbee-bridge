# Zigbee 配置
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_MACSPLIT_UART=y

# OpenThread Spinel 配置（RCP 通信必需）
CONFIG_OPENTHREAD_SPINEL_ONLY=y
CONFIG_OPENTHREAD_SPINEL_RX_FRAME_BUFFER_SIZE=2048
CONFIG_OPENTHREAD_SPINEL_MAC_MAX_CSMA_BACKOFFS_DIRECT=4

# Flash 大小
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 自定义分区表（Zigbee 需要 zb_storage 分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
